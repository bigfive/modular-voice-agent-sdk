{
  "name": "modular-voice-agent-sdk",
  "version": "2.6.0",
  "description": "Modular isomorphic STT → LLM → TTS pipeline library for AI voice agents and voice assistants",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./native": {
      "import": "./dist/backends/native/index.js",
      "types": "./dist/backends/native/index.d.ts"
    },
    "./cloud": {
      "import": "./dist/backends/cloud/index.js",
      "types": "./dist/backends/cloud/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./agent": {
      "import": "./dist/backends/agent/index.js",
      "types": "./dist/backends/agent/index.d.ts"
    }
  },
  "bin": {
    "mvas": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "USAGE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "npm run build"
  },
  "workspaces": [
    "examples"
  ],
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "number-to-words": "^1.2.4",
    "ulid": "^3.0.2"
  },
  "peerDependencies": {
    "ws": "^8.0.0",
    "@opencode-ai/sdk": "*",
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    },
    "@opencode-ai/sdk": {
      "optional": true
    },
    "@mariozechner/pi-agent-core": {
      "optional": true
    },
    "@mariozechner/pi-ai": {
      "optional": true
    },
    "@mariozechner/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/number-to-words": "^1.2.3",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "voice",
    "voice-agent",
    "voice-assistant",
    "speech-to-text",
    "text-to-speech",
    "speech-to-speech",
    "stt",
    "tts",
    "llm",
    "conversational-ai",
    "voice-ai",
    "realtime",
    "streaming",
    "audio",
    "ai-assistant",
    "modular",
    "MVAS",
    "modular-voice-agent-sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigfive/modular-voice-agent-sdk.git"
  },
  "author": "Jonathan Williams <bigfive@users.noreply.github.com>",
  "homepage": "https://github.com/bigfive/modular-voice-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/bigfive/modular-voice-agent-sdk/issues"
  }
}

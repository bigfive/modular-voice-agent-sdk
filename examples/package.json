{
  "name": "modular-voice-agent-sdk-examples",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "example0": "vite --open /example-0-bare-bones/",
    "setup": "npm run setup:binaries && npm run setup:models",
    "setup:binaries": "mvas setup --binaries-only",
    "setup:models": "mvas setup example-4-native-native-native/models.json && mvas setup example-5-speech-native-speech/models.json && mvas setup example-7-native-transformers-speech/models.json && mvas setup example-9-native-cloud-native/models.json && mvas setup example-10-cloudaudio-speech/models.json",
    "example1": "vite --open /example-1-speech-browser-speech/",
    "example2": "vite --open /example-2-browser-browser-speech/",
    "example3": "concurrently -k -n vite,server -c blue,green \"vite --open /example-3-transformers-transformers-transformers/\" \"tsx watch example-3-transformers-transformers-transformers/server.ts\"",
    "example4": "concurrently -k -n vite,server -c blue,yellow \"vite --open /example-4-native-native-native/\" \"tsx watch example-4-native-native-native/server.ts\"",
    "example5": "concurrently -k -n vite,server -c blue,magenta \"vite --open /example-5-speech-native-speech/\" \"tsx watch example-5-speech-native-speech/server.ts\"",
    "example6": "concurrently -k -n vite,server -c blue,cyan \"vite --open /example-6-transformers-transformers-speech/\" \"tsx watch example-6-transformers-transformers-speech/server.ts\"",
    "example7": "concurrently -k -n vite,server -c blue,red \"vite --open /example-7-native-transformers-speech/\" \"tsx watch example-7-native-transformers-speech/server.ts\"",
    "example8": "concurrently -k -n vite,server -c blue,#a78bfa \"vite --open /example-8-speech-cloud-speech/\" \"tsx watch example-8-speech-cloud-speech/server.ts\"",
    "example9": "concurrently -k -n vite,server -c blue,#f97316 \"vite --open /example-9-native-cloud-native/\" \"tsx watch example-9-native-cloud-native/server.ts\"",
    "example10": "concurrently -k -n vite,server -c blue,#f472b6 \"vite --open /example-10-cloudaudio-speech/\" \"tsx watch example-10-cloudaudio-speech/server.ts\"",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "modular-voice-agent-sdk": "file:..",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^9.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.0"
  }
}
